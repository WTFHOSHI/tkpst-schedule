{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "tkpst-account",
  "main": "./worker/account-gateway.mjs",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/schedule_api/*", "/health"]
  }
}
